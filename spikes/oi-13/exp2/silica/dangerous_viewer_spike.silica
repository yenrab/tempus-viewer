use trial_wait_int64;

module dangerous_viewer_spike;

wrapper_meta "dangerous_exposure_source/host/viewer_host_wrapper.meta";

foreign c_wrapper "viewer_next_event"
fn next_event_raw() -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "viewer_post"
fn post_raw(text_ptr: uint8, text_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

fn sink(msg: string, state: string) -> (:no_reply, string) {
    (:no_reply, state)
}

// FFI worker: sends one command to the Swift host.
fn poster(msg: string, keep: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger]
        _: string <- post_raw(msg)
    produces
        pure (:no_reply, keep)
    end
}

// Window actor: turns an event reaction into a command for the host.
fn window(msg: string, out: dangerous_actor_ref) -> (:no_reply, dangerous_actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast(out, msg impl ActorMessage {})
    produces
        pure (:no_reply, out)
    end
}

// Listener actor: receives host events and passes them to the window actor.
fn listener(msg: string, win: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        _: boolean <- cast(win, msg impl ActorMessage {})
    produces
        pure (:no_reply, win)
    end
}

// FFI worker: blocks until the host has an event, gives it to the listener, and asks itself again.
fn poller(msg: string, lis: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency]
        ev: string <- next_event_raw();
        _: boolean <- cast(lis, ev impl ActorMessage {});
        _: boolean <- cast(self(), "poll" impl ActorMessage {})
    produces
        pure (:no_reply, lis)
    end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                s: actor_ref <- spawn("", sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                p: dangerous_actor_ref <- spawn_dangerous(s, poster, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                w: actor_ref <- spawn(p, window, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                l: actor_ref <- spawn(w, listener, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                q: dangerous_actor_ref <- spawn_dangerous(l, poller, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(q, "poll" impl ActorMessage {})
            produces
                pure 0
            end
        });
        _: int64 <- wait_for_exit()
    produces
        pure 0
    end
}
