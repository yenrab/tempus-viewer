# The recipe of one of the testnet's TRUST nodes (content, data, authority), included by the leaf's Makefile after it sets NODE.
# Modelled on BEES's trials/c3_tempus_bridge/nodes/t. Generated by the rule of .gen.mk (an included makefile, so make starts again
# and sees the new units): lib/rep_*.silica, lib/*.atoms, lib/node.trust and trust_whitelist.config from testnet/data/gen_nodes.py,
# the TRUST configuration (bees_config_trust.py), the MFA table (bees_trust_gen.py mfa) and the root unit dangerous_NODE.silica
# (bees_trust_gen.py edge).
LEAF_DIR := $(abspath $(dir $(firstword $(MAKEFILE_LIST))))
include $(LEAF_DIR)/../common.mk
T := $(BEES_ROOT)/tools
DATA := $(TESTNET)/data
_ := $(shell cd "$(LEAF_DIR)" && [ "$$(cat .gen.root 2>/dev/null)" = "$(BEES_ROOT)" ] || echo "$(BEES_ROOT)" > .gen.root)
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(LEAF_DIR)/.gen.root bees.config.in $(TESTNET)/nodes/trust_node.role $(DATA)/gen_nodes.py $(DATA)/gen_silica.py $(DATA)/gen.py $(DATA)/vocab.py $(T)/bees_trust_gen.py $(BEES_ROOT)/src/shim/bees_trust_node.part
	@cd "$(LEAF_DIR)" && $(LINKS) && cd "$(LEAF_DIR)" && \
	sed 's|@BEES_ROOT@|$(BEES_ROOT)|g' bees.config.in > bees.config && chmod 600 "$(CERTS_TRUST)"/*-key.pem && \
	python3 "$(DATA)/gen_nodes.py" --node $(NODE) --out . && \
	python3 "$(T)/bees_config_trust.py" conf -o lib bees.config && \
	python3 "$(T)/bees_trust_gen.py" mfa -o lib --config bees.config lib/node.trust && \
	python3 "$(T)/bees_trust_gen.py" edge dangerous_$(NODE) dangerous_$(NODE).silica "$(TESTNET)/nodes/trust_node.role" && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
# make expands the names, so only files that exist are named
GENERATED := $(wildcard $(LEAF_DIR)/lib/* $(LEAF_DIR)/*.sams $(LEAF_DIR)/*.iface $(LEAF_DIR)/*.o $(LEAF_DIR)/.gen.* $(LEAF_DIR)/bees.config $(LEAF_DIR)/trust_whitelist.config $(LEAF_DIR)/dangerous_$(NODE) $(LEAF_DIR)/dangerous_$(NODE).silica $(LEAF_DIR)/silica.* $(LEAF_DIR)/dangerous_exposure_source)
clean-generated:
	@rm -f $(GENERATED)
