# The testnet's content node: a TRUST node (modelled on BEES's trials/c3_tempus_bridge/nodes/t). Generated by the rule of
# .gen.mk (an included makefile, so make starts again and sees the new units): the reply unit lib/viewer_replies.silica and its
# manifest from testnet/data (gen_silica.py), the TRUST configuration (bees_config_trust.py), the MFA table
# (bees_trust_gen.py mfa) and the root unit dangerous_content.silica (bees_trust_gen.py edge).
# make BEES_ROOT=... SILICA_ROOT=... SILICA_COMPILER=... build
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
include $(LEAF_DIR)/../common.mk
NAMES ?= home
T := $(BEES_ROOT)/tools
DATA := $(TESTNET)/data
# the configuration bakes absolute paths of the certificates: the units are made again when BEES_ROOT or NAMES change
_ := $(shell cd "$(LEAF_DIR)" && [ "$$(cat .gen.root 2>/dev/null)" = "$(BEES_ROOT) $(NAMES)" ] || echo "$(BEES_ROOT) $(NAMES)" > .gen.root)
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(LEAF_DIR)/.gen.root bees.config.in trust_whitelist.config content.role node.atoms $(DATA)/gen_silica.py $(DATA)/gen.py $(DATA)/vocab.py $(T)/bees_trust_gen.py $(BEES_ROOT)/src/shim/bees_trust_node.part
	@cd "$(LEAF_DIR)" && $(LINKS) && cd "$(LEAF_DIR)" && \
	sed 's|@BEES_ROOT@|$(BEES_ROOT)|g' bees.config.in > bees.config && chmod 600 "$(CERTS_TRUST)"/*-key.pem && \
	python3 "$(DATA)/gen_silica.py" --names $(NAMES) --module viewer_replies --also-atoms-for bees_trust_mfa --out lib && \
	python3 "$(T)/bees_config_trust.py" conf -o lib bees.config && \
	python3 "$(T)/bees_trust_gen.py" mfa -o lib --config bees.config lib/viewer_replies.trust && \
	python3 "$(T)/bees_trust_gen.py" edge dangerous_content dangerous_content.silica content.role && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
# make expands the names, so only files that exist are named
GENERATED := $(wildcard $(LEAF_DIR)/lib/* $(LEAF_DIR)/*.sams $(LEAF_DIR)/*.iface $(LEAF_DIR)/*.o $(LEAF_DIR)/.gen.* $(LEAF_DIR)/bees.config $(LEAF_DIR)/dangerous_content $(LEAF_DIR)/dangerous_content.silica $(LEAF_DIR)/silica.* $(LEAF_DIR)/dangerous_exposure_source)
clean-generated:
	@rm -f $(GENERATED)
