// The testnet's bridge (modelled on BEES's trials/c3_tempus_bridge/roles/bridge.role and b1.role, with the trial's own scenarios
// taken out): a thin program that starts the TRUST side as every TRUST node starts it (trust_boot, trust_start: bees.config,
// TEST-ONLY certificates of BEES's N4.1 trial) and the TEMPUS side with tempus_bridge_start (src/tempus/bees_tempus_bridge.part),
// passing the TEST-ONLY values of lib/tempus_ids.silica and the limits below, and answers every admitted call of an edge
// (design 17.4 step 2). The bridge forwards nothing by itself: this application calls onward.
// What it does with each function an edge may call (edge.spec permits, lib/bridge_fns.trust types; both and the routing in
// on_call are generated by testnet/data/gen_nodes.py --bridge from its table of nodes): a call is passed to the TRUST node that
// serves the name (content, data or authority) with the edge's arguments as they came; viewer:mark/1 is passed to the authority
// node as viewer:mark_of/1. Limits: the c3 trial's, except 100000 requests per peer per hour (the trial's 20 is below what
// the verification of all names needs).
// TEMPUS identity 3 ("bridge" of the t5 trial's certificates). The values below are those of BEES's trial b1; the port is
// 24401 (the viewer's eventual port is 481).
//$ BA = { n: int64 }
fn region_dump_limit() -> int64 { 0 }
fn port() -> string { "24401" }
fn me() -> int64 { 3 }
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
// the same as bees_tempus_bridge@tonw (the reply of the onward TRUST call becomes the request's result or failure), with a line
// for what the TRUST node answered, so a failure is not anonymous
fn tonw2(msg: { req: int64, what: atom, value: string }, rq: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency, device_io]
        why: string <- bees_atoms@spelling(msg.what);
        _: atom <- println(concat(concat("onward: the TRUST node answered ", why), concat(", value bytes ", bees_trust_frame@int_text(length_bytes(msg.value)))));
        _: boolean <- case msg.what == :ok of { true -> bees_tempus_bridge@rq_result(rq, msg.value); false -> bees_tempus_bridge@rq_fail(rq, why) };
        _: atom <- stop_self(:normal)
    produces pure (:no_reply, rq) end
}
fn onward(rq: actor_ref, addr: string, m: atom, f: atom, arity: int64, args: string) -> atom {
    sequence proc[concurrency]
        h: actor_ref <- spawn(rq, tonw2, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r: atom <- trpc_call(addr, m, f, arity, args, h, 0)
    produces pure r end
}
fn hx(s: string) -> string { tempus_ids@unhex(s) }
// fwd: one onward TRUST call to a node (addr), the edge's arguments as they came
fn fwd(s: $BA$, rq: actor_ref, addr: string, m: atom, f: atom, ar: int64, args: string) -> $BA$ {
    sequence _: atom <- onward(rq, addr, m, f, ar, args) produces pure s end
}
//@ON_CALL@
fn app_bees(s: $BA$, me: actor_ref, b: $NB$) -> $BA$ {
    case b.op of {
        90 -> on_call(s, me, b.s1, b.s2, b.who);
        80 -> { sequence _: atom <- say(concat("application: told that the node's own token is not valid any more: ", b.s1)) produces pure s end };
        81 -> { sequence _: atom <- say(concat("application: a peer answered key_rotated and named kid ", b.s1)) produces pure s end };
        84 -> { sequence _: atom <- say(concat("application: the bridge did not start: ", b.s1)) produces pure s end };
        _: int64 -> s
    }
}
fn app(msg: $NM$, s: $BA$) -> (:no_reply, $BA$) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        s2: $BA$ <- case msg of {
            (:accepted, _l: dangerous_actor_ref, _i: string) -> s;
            (:link_up, _info: string) -> s;
            (:rx, _s: string) -> s;
            (:tx_credit, _n: int64) -> s;
            (:tx_failed, _w: atom) -> s;
            (:link_down, _w2: atom) -> s;
            (:bees, op: int64, s1: string, sb: string, n: int64, m: int64, who: actor_ref) -> app_bees(s, me, { op: op, s1: s1, s2: sb, n: n, m: m, who: who })
        }
    produces pure (:no_reply, s2) end
}
fn wl() -> string { concat(concat(tempus_ids@fp_hex(3), tempus_ids@fp_hex(4)), tempus_ids@fp_hex(7)) }
fn tempus_side() -> atom {
    sequence proc[concurrency]
        a: actor_ref <- spawn({ n: 0 }, app, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        idn: $NI$ <- { id: hx(tempus_ids@id_hex(me())), pub: hx(tempus_ids@pub_hex(me())), seed: hx(tempus_ids@seed_hex(me())), addr: concat("127.0.0.1:", port()), token: hx(tempus_ids@tok_hex(me(), 13)), typ: 2 };
        net: $NN$ <- { listen: concat("listen:", port()), spec: tempus_spec(tempus_ids@certfile(me()), tempus_ids@keyfile(me())), sents: "", wl: wl(), kid: tempus_ids@kid(), ppub: hx(tempus_ids@producer_pub_hex()), ms: 5000, mst: "5000", max: 4, skew: tempus_ids@skew(), j0: 200, j1: 800, back: 1, blim: 0, fail: 2, every: 1000 };
        sz: $NZ$ <- { k1: 4, c1: 3, t1: 1000, k2: 4, c2: 2, t2: 1000, k3: 4, c3: 2, t3: 1000 };
        x: actor_ref <- bees_tempus_test@start(tempus_ids@now());
        drv: $NT$ <- { driven: true, ext: x, draws: "0,1,2,3" };
        lim: $BL$ <- { slim: 5, size: 4, rate: 100000, ivl: 3600000, pin: 2, tin: 4, cms: 4000 };
        b: actor_ref <- tempus_bridge_start(a, idn, net, sz, drv, lim)
    produces pure :ok end
}
// the program's failure reporter: every report to standard error. Not bees_reporter: a bridge program is at 32 units, and a
// 33rd made the root unit fail E4045 at its carrier (BEES development-plan/silica-defects.md, the 2026-11-19 T6 note)
fn reporter(report: string, st: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println_stderr(report)
    produces pure (:no_reply, st) end
}
fn start_reporter() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: atom <- register_failure_reporter(r)
    produces pure ok end
}
fn bridge_start() -> atom {
    sequence
        _: atom <- start_reporter();
        _: atom <- trust_start();
        _: atom <- tempus_side()
    produces pure :ok end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        b: int64 <- trust_boot();
        _: atom <- case b == 0 of { true -> bridge_start(); false -> :ok };
        rc: int64 <- case b == 0 of { true -> wait_for_exit(); false -> 1 }
    produces pure rc end
}
