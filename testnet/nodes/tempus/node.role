// The application of every testnet TEMPUS-only node (from BEES's trials/t3_tempus_nodes/node.role): a thin program that
// passes the TEST-ONLY values of lib/tempus_ids.silica to tempus_node_start (src/tempus/bees_tempus_node.part) and prints what
// the node tells its application. Its entry's role file gives me() (the identity's number), typ() (1 edge, 3 sentinel),
// port() and sents(). TEST network only.
// Externally driven, like the testnet's bridge: the test unit (lib/bees_tempus_test.silica) is the clock (fixed at
// tempus_ids@now(), 1500, inside every test token's validity) and the stores are ticked by a peer's tick frame. The node
// listens, joins through its sentinel at start and answers shuffles and samples by itself. Stores: capacity 4, shuffle
// length 3 (edge) and 2 (bridge, sentinel) as in the bridge. inflight_max 4. The whitelist holds the certificates of the
// sentinel, the bridge and x4 (the checks' bridge-typed client): a certificate on the whitelist must come with a bridge or sentinel token, so an edge's certificate is not listed (an edge is a peer that is on no list).
fn region_dump_limit() -> int64 { 0 }
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn hx(s: string) -> string { tempus_ids@unhex(s) }
fn app_line(op: int64, s1: string) -> atom {
    case op of {
        80 -> say(concat("application: told that the node's own token is not valid any more: ", s1));
        81 -> say(concat("application: told that a peer answered key_rotated, its current kid is ", s1));
        _: int64 -> :ok
    }
}
fn app(msg: $NM$, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case msg of {
            (:accepted, _l: dangerous_actor_ref, _i: string) -> :ok;
            (:link_up, _info: string) -> :ok;
            (:rx, _s: string) -> :ok;
            (:tx_credit, _n: int64) -> :ok;
            (:tx_failed, _w: atom) -> :ok;
            (:link_down, _w2: atom) -> :ok;
            (:bees, op: int64, s1: string, _s2: string, _n2: int64, _m: int64, _who: actor_ref) -> app_line(op, s1)
        }
    produces pure (:no_reply, st + 1) end
}
fn wl() -> string { concat(concat(tempus_ids@fp_hex(2), tempus_ids@fp_hex(3)), tempus_ids@fp_hex(7)) }
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        a: actor_ref <- spawn(0, app, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        idn: $NI$ <- { id: hx(tempus_ids@id_hex(me())), pub: hx(tempus_ids@pub_hex(me())), seed: hx(tempus_ids@seed_hex(me())), addr: concat("127.0.0.1:", port()), token: hx(tempus_ids@tok_hex(me(), typ())), typ: typ() };
        net: $NN$ <- { listen: concat("listen:", port()), spec: tempus_spec(tempus_ids@certfile(me()), tempus_ids@keyfile(me())), sents: sents(), wl: wl(), kid: tempus_ids@kid(), ppub: hx(tempus_ids@producer_pub_hex()), ms: 3000, mst: "3000", max: 4, skew: tempus_ids@skew(), j0: 200, j1: 800, back: 1, blim: 0, fail: 2, every: 1000 };
        sz: $NZ$ <- { k1: 4, c1: 3, t1: 1000, k2: 4, c2: 2, t2: 1000, k3: 4, c3: 2, t3: 1000 };
        x: actor_ref <- bees_tempus_test@start(tempus_ids@now());
        drv: $NT$ <- { driven: true, ext: x, draws: "0,1,2,3" };
        n: actor_ref <- tempus_node_start(a, idn, net, sz, drv);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
