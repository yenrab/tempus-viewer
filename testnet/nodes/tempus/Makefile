# The testnet's TEMPUS-only nodes: one sentinel and three edges, four programs from one leaf (modelled on BEES's
# trials/t3_tempus_nodes: the node part, the link edge and the carrier edge, one role file per node and one shared
# application, node.role). Each is a TEMPUS node and nothing else: no TRUST side. TEST network only.
# They are started EXTERNALLY DRIVEN with BEES's test unit (src/tempus_test), as the bridge is: see the README, Stage 3.
# Generated by the rule of .gen.mk (an included makefile, so make starts again and sees the new units).
# make BEES_ROOT=... SILICA_ROOT=... SILICA_COMPILER=... build
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
include $(LEAF_DIR)/../common.mk
T := $(BEES_ROOT)/tools
SRC_T := $(BEES_ROOT)/src/tempus
ENTRY_ROLES := sentinel edge1 edge2 edge3
USES := --use tempus_ids --use bees_tempus_store --use bees_tempus_store_actor --use bees_tempus_node --use dangerous_bees_tempus_draws --use bees_tempus_test
# what t3's lib/ holds: the TEMPUS units, the test unit, the TRUST frame unit (the node part uses it) and the TLS native edge
LNK_NODE_TRUST := bees_trust_frame.silica bees_trust.atoms dangerous_bees_tls_native.silica \
  dangerous_bees_trust_edge.silica dangerous_bees_trust_native.silica
_ := $(shell cd "$(LEAF_DIR)" && [ "$$(cat .gen.root 2>/dev/null)" = "$(BEES_ROOT)" ] || echo "$(BEES_ROOT)" > .gen.root)
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(LEAF_DIR)/.gen.root node.role $(wildcard $(LEAF_DIR)/*.role) $(T)/bees_tempus_gen.py $(SRC_T)/bees_tempus_node.silica.in $(SRC_T)/bees_tempus_node.part $(SRC_T)/bees_tempus_link.part $(BEES_ROOT)/src/shim/bees_tcp_edge.part
	@cd "$(LEAF_DIR)" && mkdir -p lib && cd lib && \
	for f in $(LNK_NODE_TRUST); do ln -sfn "$(BEES_ROOT)/src/trust/$$f" "$$f"; done && \
	for f in $(filter-out bees_tempus_bridge.silica,$(LNK_TEMPUS)); do ln -sfn "$(BEES_ROOT)/src/tempus/$$f" "$$f"; done && \
	for f in $(LNK_TEMPUS_TEST); do ln -sfn "$(BEES_ROOT)/src/tempus_test/$$f" "$$f"; done && \
	ln -sfn "$(BEES_ROOT)/src/shim/bees_reporter.silica" bees_reporter.silica && \
	for f in $(LNK_STD); do ln -sfn "$(SILICA_ROOT)/compiler/stdlib/$$f" "$$f"; done && \
	ln -sfn "$(SILICA_ROOT)/compiler/stdlib/Carrier.silica" carrier.silica && \
	ln -sfn "$(BEES_ROOT)/native/dangerous_exposure_source" ../dangerous_exposure_source && cd .. && \
	python3 "$(T)/bees_tempus_ids.py" write lib/tempus_ids.silica "$(CERTS_TEMPUS)/" && \
	python3 "$(T)/bees_tempus_gen.py" unit "$(SRC_T)/bees_tempus_node.silica.in" lib/bees_tempus_node.silica && \
	for n in $(ENTRY_ROLES); do python3 "$(T)/bees_tempus_gen.py" edge dangerous_$$n dangerous_$$n.silica $(USES) --part bees_tempus_node.part $$n.role node.role || exit 1; done && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
# make expands the names, so only files that exist are named
GENERATED := $(wildcard $(LEAF_DIR)/lib/* $(LEAF_DIR)/*.sams $(LEAF_DIR)/*.iface $(LEAF_DIR)/*.o $(LEAF_DIR)/.gen.* $(foreach n,$(ENTRY_ROLES),$(LEAF_DIR)/dangerous_$(n) $(LEAF_DIR)/dangerous_$(n).silica) $(LEAF_DIR)/silica.* $(LEAF_DIR)/dangerous_exposure_source $(LEAF_DIR)/node.atoms)
clean-generated:
	@rm -f $(GENERATED)
